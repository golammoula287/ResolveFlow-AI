DATABASE_URL=postgresql://resolveflow:local_password@localhost:5433/resolveflow
JWT_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
# Groq draft generation; keyword retrieval works without embeddings.
AI_PROVIDER=groq
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional alternative: AI_PROVIDER=openai with OPENAI_API_KEY and AI_MODEL.
# OPENAI_API_KEY=
# AI_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
REDIS_URL=redis://127.0.0.1:6380
DELIVERY_MODE=disabled
# RESEND_API_KEY=
# DELIVERY_FROM=Support <support@your-verified-domain.example>
# WEBHOOK_SIGNING_SECRET=<at least 32 random characters>
# CRON_SECRET=<at least 32 random characters>
# RESEND_WEBHOOK_SECRET=<Resend signing secret>
