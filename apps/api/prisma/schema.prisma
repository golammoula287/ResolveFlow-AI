generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  AGENT
  VIEWER
}
enum Status {
  OPEN
  PENDING
  RESOLVED
}
enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  memberships Membership[]
}
model Workspace {
  id String @id @default(cuid())
  name String
  memberships Membership[]
  tickets Ticket[]
  events AuditEvent[]
  invitations Invitation[]
  documents KnowledgeDocument[]
  drafts Draft[]
  aiRuns AiRun[]
}
model Membership {
  userId String
  workspaceId String
  role Role @default(AGENT)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@id([userId, workspaceId])
  @@index([workspaceId])
}
model Ticket {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject String
  customerEmail String
  status Status @default(OPEN)
  priority Priority @default(NORMAL)
  assigneeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages Message[]
  drafts Draft[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
}
model Message {
  id String @id @default(cuid())
  ticketId String
  workspaceId String
  ticket Ticket @relation(fields: [ticketId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  body String
  authorId String
  createdAt DateTime @default(now())
  @@index([workspaceId, ticketId])
}
model AuditEvent {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId String
  action String
  resourceId String
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}

model Invitation {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email String
  role Role
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([workspaceId, email])
}

model KnowledgeDocument {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title String
  filename String
  version Int @default(1)
  contentHash String
  approved Boolean @default(false)
  createdBy String
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  chunks KnowledgeChunk[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
}
model KnowledgeChunk {
  id String @id @default(cuid())
  documentId String
  workspaceId String
  document KnowledgeDocument @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  ordinal Int
  content String
  embedding Float[] @default([])
  embeddingModel String?
  @@unique([documentId, ordinal])
  @@index([workspaceId, embeddingModel])
}
model Draft {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticketId String
  ticket Ticket @relation(fields: [ticketId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  status String
  body String
  reason String?
  citations Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  version Int @default(1)
  reviewedBy String?
  reviewedAt DateTime?
  approvedVersion Int?
  rejectionReason String?
  revisions DraftRevision[]
  reviews DraftReview[]
  @@unique([id, workspaceId])
  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, ticketId, createdAt])
}
model AiRun {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operation String
  model String?
  status String
  latencyMs Int
  inputTokens Int?
  outputTokens Int?
  costUsd Float?
  errorCode String?
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}

model DraftRevision {
  id String @id @default(cuid())
  draftId String
  workspaceId String
  draft Draft @relation(fields: [draftId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  version Int
  body String
  citations Json
  changedBy String
  createdAt DateTime @default(now())
  reviews DraftReview[]
  @@unique([draftId, workspaceId, version])
}
model DraftReview {
  id String @id @default(cuid())
  draftId String
  workspaceId String
  draft Draft @relation(fields: [draftId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  version Int
  revision DraftRevision @relation(fields: [draftId, workspaceId, version], references: [draftId, workspaceId, version], onDelete: Cascade)
  action String
  actorId String
  reason String?
  bodyHash String
  createdAt DateTime @default(now())
  @@index([workspaceId, draftId, createdAt])
}
