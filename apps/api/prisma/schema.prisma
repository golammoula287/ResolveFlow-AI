generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  AGENT
  VIEWER
}
enum Status {
  OPEN
  PENDING
  RESOLVED
}
enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  memberships Membership[]
}
model Workspace {
  id String @id @default(cuid())
  name String
  memberships Membership[]
  tickets Ticket[]
  events AuditEvent[]
  invitations Invitation[]
  documents KnowledgeDocument[]
  drafts Draft[]
  aiRuns AiRun[]
  jobs WorkflowJob[]
  deliveries Delivery[]
  webhookEvents WebhookEvent[]
  ingestionFailures IngestionFailure[]
  automation AutomationRule?
  webhookEnabled Boolean @default(false)
}
model Membership {
  userId String
  workspaceId String
  role Role @default(AGENT)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@id([userId, workspaceId])
  @@index([workspaceId])
}
model Ticket {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject String
  customerEmail String
  status Status @default(OPEN)
  priority Priority @default(NORMAL)
  assigneeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages Message[]
  drafts Draft[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
}
model Message {
  id String @id @default(cuid())
  ticketId String
  workspaceId String
  ticket Ticket @relation(fields: [ticketId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  body String
  authorId String
  createdAt DateTime @default(now())
  @@index([workspaceId, ticketId])
}
model AuditEvent {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId String
  action String
  resourceId String
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}

model Invitation {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email String
  role Role
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([workspaceId, email])
}

model KnowledgeDocument {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title String
  filename String
  version Int @default(1)
  contentHash String
  approved Boolean @default(false)
  createdBy String
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  seriesId String @default(cuid())
  supersedesId String?
  chunks KnowledgeChunk[]
  @@unique([id, workspaceId])
  @@unique([workspaceId, seriesId, version])
  @@index([workspaceId, createdAt])
}
model KnowledgeChunk {
  id String @id @default(cuid())
  documentId String
  workspaceId String
  document KnowledgeDocument @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  ordinal Int
  content String
  embedding Float[] @default([])
  embeddingModel String?
  @@unique([documentId, ordinal])
  @@index([workspaceId, embeddingModel])
}
model Draft {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticketId String
  ticket Ticket @relation(fields: [ticketId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  status String
  origin String @default("AI")
  body String
  reason String?
  citations Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  version Int @default(1)
  reviewedBy String?
  reviewedAt DateTime?
  approvedVersion Int?
  rejectionReason String?
  revisions DraftRevision[]
  reviews DraftReview[]
  deliveries Delivery[]
  @@unique([id, workspaceId])
  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, ticketId, createdAt])
}
model AiRun {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operation String
  model String?
  status String
  latencyMs Int
  inputTokens Int?
  outputTokens Int?
  costUsd Float?
  errorCode String?
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}

model DraftRevision {
  id String @id @default(cuid())
  draftId String
  workspaceId String
  draft Draft @relation(fields: [draftId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  version Int
  body String
  citations Json
  changedBy String
  createdAt DateTime @default(now())
  reviews DraftReview[]
  @@unique([draftId, workspaceId, version])
}
model DraftReview {
  id String @id @default(cuid())
  draftId String
  workspaceId String
  draft Draft @relation(fields: [draftId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  version Int
  revision DraftRevision @relation(fields: [draftId, workspaceId, version], references: [draftId, workspaceId, version], onDelete: Cascade)
  action String
  actorId String
  reason String?
  bodyHash String
  createdAt DateTime @default(now())
  @@index([workspaceId, draftId, createdAt])
}

model WorkflowJob {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind String
  status String @default("PENDING")
  idempotencyKey String
  actorId String
  attempts Int @default(0)
  generation Int @default(0)
  firstAttemptAt DateTime?
  dispatchedAt DateTime?
  lastError String?
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  delivery Delivery?
  history JobAttempt[]
  @@unique([workspaceId, idempotencyKey])
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([status, dispatchedAt])
}
model JobAttempt {
  id String @id @default(cuid())
  jobId String
  workspaceId String
  job WorkflowJob @relation(fields: [jobId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  number Int
  status String
  errorCode String?
  durationMs Int
  createdAt DateTime @default(now())
  @@index([workspaceId, jobId, createdAt])
}
model Delivery {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobId String @unique
  job WorkflowJob @relation(fields: [jobId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  draftId String
  draft Draft @relation(fields: [draftId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  version Int
  approvalId String
  recipient String
  subject String
  body String
  bodyHash String
  status String @default("QUEUED")
  provider String
  providerId String? @unique
  providerEventAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([jobId, workspaceId])
  @@unique([workspaceId, draftId, version])
  @@index([workspaceId, createdAt])
}
model AutomationRule {
  workspaceId String @id
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enabled Boolean @default(false)
  minAgeHours Int @default(24)
  createdBy String
  updatedAt DateTime @updatedAt
}
model WebhookEvent {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventId String
  payloadHash String
  ticketId String
  createdAt DateTime @default(now())
  @@unique([workspaceId, eventId])
}
model IngestionFailure {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId String
  code String
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}
model WorkerHeartbeat {
  id String @id
  updatedAt DateTime @updatedAt
}
