DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&connection_limit=5
JWT_SECRET=replace-with-32-or-more-random-characters
WEB_ORIGIN=https://your-project.vercel.app
AI_PROVIDER=groq
GROQ_API_KEY=replace-with-your-key
GROQ_MODEL=openai/gpt-oss-20b
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
CRON_SECRET=replace-with-a-separate-32-character-secret
WEBHOOK_SIGNING_SECRET=replace-with-another-32-character-secret
DELIVERY_MODE=disabled
# For live email set DELIVERY_MODE=resend and configure:
# RESEND_API_KEY=
# DELIVERY_FROM=Support <support@verified-domain.example>
# RESEND_WEBHOOK_SECRET=
# VITE_API_URL should be empty or unset for same-origin production access.
